// MyFirmware Main Entry
// TODO: Initialize hardware, read SSD, load OS to RAM, and jump to it.

// Simple serial output for firmware
i32 SERIAL_TX_ADDR = 0x24000000;

void print_str(str s) {
    i32 i = 0;
    while (i < s.length) {
        char* tx = (char*)SERIAL_TX_ADDR;
        *tx = s.data[i];
        i++;
    }
}

i32 SSD_CMD_ADDR    = 0x24000010;
i32 SSD_BLOCK_ADDR  = 0x24000014;
i32 SSD_ADDR_ADDR   = 0x24000018;
i32 SSD_STATUS_ADDR = 0x2400001C;

i32 SSD_CMD_READ    = 1;
i32 SSD_STATUS_BUSY = 1;
i32 SSD_STATUS_DONE = 2;

// External function defined in jump.masm
extern void jump_to_kernel();

// The kernel image goes here; jump.masm jumps here.
i32 KERNEL_BASE = 0x00100000;
// Its first block on the SSD; tools/mkfs.py puts it there.
i32 KERNEL_BLOCK = 16000;
// The most blocks of 64 KB it may take: 4 MB. tools/mkfs.py refuses a bigger image.
i32 MAX_KERNEL_BLOCKS = 64;
i32 BLOCK_BYTES = 65536;

/**
 * Reads one 64 KB block from the SSD into RAM.
 * @param block Block number.
 * @param addr Where in RAM it goes.
 * @return Whether the read succeeded.
 */
bool load_block(i32 block, i32 addr) {
    i32* p_block = (i32*)SSD_BLOCK_ADDR;
    i32* p_addr  = (i32*)SSD_ADDR_ADDR;
    i32* p_cmd   = (i32*)SSD_CMD_ADDR;
    i32* p_status = (i32*)SSD_STATUS_ADDR;

    *p_block = block;
    *p_addr = addr;
    *p_cmd = SSD_CMD_READ;

    // The DMA runs asynchronously: STATUS reads BUSY until the device
    // completes the transfer. Interrupts are off in firmware, so busy-poll.
    while (*p_status == SSD_STATUS_BUSY) { }
    return *p_status == SSD_STATUS_DONE;
}

export void fw_main() {
    print_str("firmware: booting system...\n");
    print_str("firmware: loading OS from SSD...\n");

    // The image says how long it is: its second word is the address it ends
    // at (system/MyOS/src/boot/stub.masm). Load the first block, read that,
    // then load the rest.
    if (!load_block(KERNEL_BLOCK, KERNEL_BASE)) {
        print_str("firmware: SSD read error!\n");
        return;
    }
    i32* image_end = (i32*)(KERNEL_BASE + 4);
    i32 blocks = (*image_end - KERNEL_BASE + BLOCK_BYTES - 1) / BLOCK_BYTES;
    if (blocks < 1 || blocks > MAX_KERNEL_BLOCKS) {
        print_str("firmware: the kernel image's size is out of range!\n");
        return;
    }
    i32 i = 1;
    while (i < blocks) {
        if (!load_block(KERNEL_BLOCK + i, KERNEL_BASE + i * BLOCK_BYTES)) {
            print_str("firmware: SSD read error!\n");
            return;
        }
        i = i + 1;
    }

    print_str("firmware: OS loaded. Jumping to Kernel...\n");
    jump_to_kernel();
}
