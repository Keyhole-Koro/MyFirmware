// MyFirmware Main Entry
// TODO: Initialize hardware, read SSD, load OS to RAM, and jump to it.

// Simple serial output for firmware
i32 SERIAL_TX_ADDR = 0x24000000;

void print_str(str s) {
    i32 i = 0;
    while (i < s.length) {
        char* tx = (char*)SERIAL_TX_ADDR;
        *tx = s.data[i];
        i++;
    }
}

i32 SSD_CMD_ADDR    = 0x24000010;
i32 SSD_BLOCK_ADDR  = 0x24000014;
i32 SSD_ADDR_ADDR   = 0x24000018;
i32 SSD_STATUS_ADDR = 0x2400001C;

i32 SSD_CMD_READ    = 1;
i32 SSD_STATUS_BUSY = 1;
i32 SSD_STATUS_DONE = 2;

// External function defined in jump.masm
extern void jump_to_kernel();

export void fw_main() {
    print_str("firmware: booting system...\n");
    print_str("firmware: loading OS from SSD...\n");

    // Load kernel from block 16000 into RAM at 0x00100000.
    // KERNEL_BLOCKS blocks of 64 KB; the image (text + data) must fit --
    // qa/runners/run_system.py checks the built size against this.
    i32 KERNEL_BLOCKS = 16;   // 1 MB
    i32 block = 16000;
    i32 addr = 0x00100000;
    i32 i = 0;
    while (i < KERNEL_BLOCKS) {
        i32* p_block = (i32*)SSD_BLOCK_ADDR;
        i32* p_addr  = (i32*)SSD_ADDR_ADDR;
        i32* p_cmd   = (i32*)SSD_CMD_ADDR;
        i32* p_status = (i32*)SSD_STATUS_ADDR;

        *p_block = block;
        *p_addr = addr;
        *p_cmd = SSD_CMD_READ;

        // The DMA runs asynchronously: STATUS reads BUSY until the device
        // completes the transfer. Interrupts are off in firmware, so busy-poll.
        while (*p_status == SSD_STATUS_BUSY) { }

        if (*p_status != SSD_STATUS_DONE) {
            print_str("firmware: SSD read error!\n");
            return;
        }

        block = block + 1;
        addr = addr + 65536;
        i = i + 1;
    }

    print_str("firmware: OS loaded. Jumping to Kernel...\n");
    jump_to_kernel();
}
